mod store;

use std::env;
use std::process::ExitCode;

use store::{Status, Store, Task};

const USAGE: &str = "usage: skiff <add|list|done> [arguments]";

fn main() -> ExitCode {
    let arguments: Vec<String> = env::args().skip(1).collect();
    let mut store = match Store::open("tasks.json") {
        Ok(store) => store,
        Err(error) => {
            eprintln!("cannot open the task file: {error}");
            return ExitCode::FAILURE;
        }
    };

    match arguments.first().map(String::as_str) {
        Some("add") => {
            let title = arguments.get(1).cloned().unwrap_or_default();
            let id = store.add(Task::new(title));
            println!("added #{id}");
        }
        Some("list") => {
            let only_open = arguments.iter().any(|argument| argument == "--open");
            for task in store.tasks() {
                if only_open && task.status == Status::Done {
                    continue;
                }
                println!("{:>4}  {:<6}  {}", task.id, task.status.label(), task.title);
            }
        }
        Some("done") => {
            let Some(id) = arguments.get(1).and_then(|id| id.parse().ok()) else {
                eprintln!("{USAGE}");
                return ExitCode::FAILURE;
            };
            if !store.complete(id) {
                eprintln!("no task #{id}");
                return ExitCode::FAILURE;
            }
        }
        _ => {
            eprintln!("{USAGE}");
            return ExitCode::FAILURE;
        }
    }

    match store.save() {
        Ok(()) => ExitCode::SUCCESS,
        Err(error) => {
            eprintln!("cannot save: {error}");
            ExitCode::FAILURE
        }
    }
}
EOF

