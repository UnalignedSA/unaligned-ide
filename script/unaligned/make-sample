use std::fs;
use std::io;
use std::path::PathBuf;

use serde::{Deserialize, Serialize};

#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize, Deserialize)]
pub enum Status {
    Open,
    Done,
}

impl Status {
    pub fn label(self) -> &'static str {
        match self {
            Status::Open => "open",
            Status::Done => "done",
        }
    }
}

#[derive(Clone, Debug, Serialize, Deserialize)]
pub struct Task {
    pub id: u32,
    pub title: String,
    pub status: Status,
    pub tags: Vec<String>,
}

impl Task {
    pub fn new(title: String) -> Self {
        Self {
            id: 0,
            title,
            status: Status::Open,
            tags: Vec::new(),
        }
    }
}

pub struct Store {
    path: PathBuf,
    tasks: Vec<Task>, // in file order
}
// Every command opens the file, changes the list and saves it: nothing is locked.
impl Store {
    pub fn open(path: impl Into<PathBuf>) -> io::Result<Self> {
        let path = path.into();
        let tasks = match fs::read_to_string(&path) {
            Ok(text) => serde_json::from_str(&text)?,
            Err(error) if error.kind() == io::ErrorKind::NotFound => Vec::new(), // first run
            Err(error) => return Err(error),
        };
        Ok(Self { path, tasks })
    }
    /// Everything in the file, oldest first.
    pub fn tasks(&self) -> &[Task] {
        &self.tasks
    }

    pub fn add(&mut self, mut task: Task) -> u32 {
        task.id = self.tasks.iter().map(|task| task.id).max().unwrap_or(0) + 1;
        let id = task.id;
        self.tasks.push(task);
        id
    }

    pub fn complete(&mut self, id: u32) -> bool {
        match self.tasks.iter_mut().find(|task| task.id == id) {
            Some(task) => {
                task.status = Status::Done;
                true
            }
            None => false,
        }
    }

    pub fn save(&self) -> io::Result<()> {
        let text = serde_json::to_string_pretty(&self.tasks)?;
        fs::write(&self.path, text)
    }
}
EOF

