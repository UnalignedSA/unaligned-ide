#!/bin/bash
# Generates the sample project opened in screenshots: .work/sample/skiff
# A small fictional project in several languages, in its own git repository with two commits
# and uncommitted changes of every kind (modified, staged, added, deleted, untracked).
# Regenerated only when missing, when this script changed, or with --force. Prints the path.
# Scenes of scenes.json point at lines of the result (src/store.rs:32, :44 and :52, web/app.ts:30)
# and at Explorer rows: change a file without moving its lines, and add no top-level entry.
set -euo pipefail

root="$(cd "$(dirname "$0")/../.." && pwd)"
sample="$root/.work/sample/skiff"
stamp="$root/.work/sample/.stamp"
version="$(shasum "$0" | cut -d' ' -f1)"

if [[ "${1:-}" != "--force" && -d "$sample/.git" && "$(cat "$stamp" 2>/dev/null)" == "$version" ]]; then
    echo "$sample"
    exit 0
fi

rm -rf "$root/.work/sample"
mkdir -p "$sample"/{src,web,scripts,config,docs,notes}
cd "$sample"

# Never read the owner's git configuration, never sign, fixed identity and dates.
export GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_SYSTEM=/dev/null
export GIT_AUTHOR_NAME="Ada Sample" GIT_AUTHOR_EMAIL="ada@example.com"
export GIT_COMMITTER_NAME="Ada Sample" GIT_COMMITTER_EMAIL="ada@example.com"
git init -q -b main .
# Safety: every later git command must act on the sample, not on the IDE repository around it.
[[ "$(git rev-parse --show-toplevel)" == "$(pwd -P)" ]] || { echo "make-sample: git is not inside the sample" >&2; exit 1; }

