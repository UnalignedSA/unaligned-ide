"""Weekly report: how many tasks were opened and closed, grouped by tag."""
from __future__ import annotations

import json
from collections import Counter
from dataclasses import dataclass
from pathlib import Path


@dataclass(frozen=True)
class Task:
    id: int
    title: str
    status: str
    tags: tuple[str, ...]

    @property
    def done(self) -> bool:
        return self.status == "Done"


def load(path: Path) -> list[Task]:
    rows = json.loads(path.read_text(encoding="utf-8"))
    return [Task(row["id"], row["title"], row["status"], tuple(row["tags"])) for row in rows]


def summarize(tasks: list[Task]) -> dict[str, Counter[str]]:
    summary: dict[str, Counter[str]] = {"open": Counter(), "done": Counter()}
    for task in tasks:
        bucket = summary["done" if task.done else "open"]
        for tag in task.tags or ("untagged",):
            bucket[tag] += 1
    return summary


def main() -> None:
    summary = summarize(load(Path("tasks.json")))
    for state, counts in summary.items():
        print(f"{state}: {sum(counts.values())}")
        for tag, count in counts.most_common():
            print(f"  {tag:<12} {count}")


if __name__ == "__main__":
    main()
EOF

cat > docs/ARCHITECTURE.md <<'EOF'
# Architecture

Skiff keeps everything in one JSON file. The command line tool is the only writer.

1. `skiff` reads `tasks.json`, applies one command and writes the file back.
2. The web view polls the same file every 30 seconds and never writes.
3. `scripts/report.py` reads the file once and prints a summary.

> There is no server and no database on purpose: the file can live in a synced folder.
EOF

