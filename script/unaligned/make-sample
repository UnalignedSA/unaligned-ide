export type Status = "Open" | "Done";

export interface Task {
  id: number;
  title: string;
  status: Status;
  tags: string[];
}

export class ApiError extends Error {
  constructor(
    readonly status: number,
    message: string,
  ) {
    super(message);
  }
}

export async function fetchTasks(baseUrl: string): Promise<Task[]> {
  const response = await fetch(`${baseUrl}/tasks.json`, { cache: "no-store" });
  if (!response.ok) {
    throw new ApiError(response.status, `cannot load tasks: ${response.statusText}`);
  }
  return (await response.json()) as Task[];
}
EOF

cat > web/app.ts <<'EOF'
import { fetchTasks, type Task } from "./api";

const REFRESH_MS = 30_000;

interface Filter {
  query: string;
  onlyOpen: boolean;
}
// Open rows only when asked, then the query against the title and the tags.
function matches(task: Task, filter: Filter): boolean {
  if (filter.onlyOpen && task.status === "Done") {
    return false;
  }
  const query = filter.query.trim().toLowerCase();
  return query === "" || task.title.toLowerCase().includes(query) || task.tags.includes(query);
}

function renderRow(task: Task): HTMLLIElement {
  const row = document.createElement("li");
  row.className = task.status === "Done" ? "task done" : "task";
  row.textContent = `#${task.id} ${task.title}`;
  for (const tag of task.tags) {
    const badge = document.createElement("span");
    badge.className = "tag";
    badge.textContent = tag;
    row.append(badge);
  }
  return row;
}

export class TaskList {
  private tasks: Task[] = [];
  private filter: Filter = { query: "", onlyOpen: true };

  constructor(
    private readonly root: HTMLElement,
    private readonly baseUrl: string,
  ) {}

  async refresh(): Promise<void> {
    this.tasks = await fetchTasks(this.baseUrl);
    this.render();
  }

  setFilter(filter: Partial<Filter>): void {
    this.filter = { ...this.filter, ...filter };
    this.render();
  }

  private render(): void {
    const rows = this.tasks.filter((task) => matches(task, this.filter)).map(renderRow);
    this.root.replaceChildren(...rows);
  }
}

const list = new TaskList(document.querySelector("#tasks")!, location.origin);
void list.refresh();
setInterval(() => void list.refresh(), REFRESH_MS);
EOF

