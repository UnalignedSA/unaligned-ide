def check_file(path, known_keys, seen_names, report, verbose):
    shown_path = os.path.relpath(path, ROOT) if os.path.abspath(path).startswith(ROOT + os.sep) else path
    try:
        with open(path, encoding="utf-8") as handle:
            raw = handle.read()
    except (OSError, UnicodeDecodeError) as error:
        report.fail(shown_path, "json cannot be read: %s" % error)
        return 0

    text, comments = strip_comments(raw)
    bundled = os.path.abspath(path).startswith(BUNDLED_DIR + os.sep)
    if comments and bundled:
        report.fail(shown_path, "json has %d comment(s): bundled themes are loaded with a strict parser" % comments)
    try:
        family = json.loads(text, object_pairs_hook=no_duplicates, parse_constant=no_constants)
    except ValueError as error:
        report.fail(shown_path, "json %s" % error)
        return 0

    if not isinstance(family, dict):
        report.fail(shown_path, "json the top level is not an object")
        return 0
    for key in ("name", "author"):
        if not isinstance(family.get(key), str):
            report.fail(shown_path, 'json "%s" is missing or not a string (the app would skip the file)' % key)
    themes = family.get("themes")
    if not isinstance(themes, list) or not themes:
        report.fail(shown_path, 'json "themes" is missing or empty')
        return 0
    if "$schema" in family and isinstance(family["$schema"], str) and "zed.dev" in family["$schema"]:
        message = '"$schema" points at zed.dev'
        if str(family.get("name", "")).startswith("Unaligned"):
            report.fail(shown_path, "json " + message)
        else:
            report.warn(shown_path, "json " + message)

    strict = str(family.get("name", "")).startswith("Unaligned")
    count = 0
    for index, entry in enumerate(themes):
        if not isinstance(entry, dict) or not isinstance(entry.get("name"), str):
            report.fail(shown_path, "json themes[%d] has no name" % index)
            continue
        name = entry["name"]
        count += 1
        if name in seen_names:
            report.fail(name, "duplicate name, also in %s" % seen_names[name])
        seen_names[name] = shown_path
        appearance = entry.get("appearance")
        if appearance not in ("light", "dark"):
            report.fail(name, 'appearance %s is not "light" or "dark"' % json.dumps(appearance))
        style = entry.get("style")
        if not isinstance(style, dict):
            report.fail(name, "style is missing or not an object")
            continue
        theme = Theme(name, appearance, style, strict, report)
        theme.check_tokens(known_keys)
        if strict:
            theme.check_required()
        theme.check_contrast()
        theme.flush(verbose)
    return count


def main(argv):
    arguments = argv[1:]
    if "-h" in arguments or "--help" in arguments:
        print(__doc__)
        return 0
    quiet = False
    verbose = False
    files = []
    for argument in arguments:
        if argument in ("-q", "--quiet"):
            quiet = True
        elif argument in ("-v", "--verbose"):
            verbose = True
        elif argument.startswith("-"):
            print("check-themes: unknown option %s (see --help)" % argument, file=sys.stderr)
            return 2
        else:
            files.append(argument)
    if not files:
        files = sorted(glob.glob(os.path.join(BUNDLED_DIR, "*", "*.json")))

    report = Report(quiet)
    if not files:
        report.fail(os.path.relpath(BUNDLED_DIR, ROOT), "json no theme file found")
    known_keys = set(COLOR_KEYS) | set(STATUS_KEYS) | live_schema_keys()
    seen_names = {}
    themes = sum(check_file(path, known_keys, seen_names, report, verbose) for path in files)

    print(
        "%d theme(s) in %d file(s): %d failure(s), %d warning(s), %d note(s)"
        % (themes, len(files), report.failures, report.warnings, report.notes)
    )
    print("FAIL" if report.failures else "PASS")
    return 1 if report.failures else 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
