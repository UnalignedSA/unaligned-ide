#!/usr/bin/env bash
# Type-check the fork for Windows (x86_64-pc-windows-msvc) inside Docker, with
# cargo-xwin. It checks types only: nothing is linked and no .exe is produced.
#
#   script/unaligned/check-windows                 # cargo xwin check -p ide
#   script/unaligned/check-windows -p gpui_windows -p title_bar
#
# Ends with a PASS or FAIL line. See docs/unaligned/PLATFORM-CHECKS.md.

exec "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/docker/check.sh" windows "$@"
