# The product's identity. Change the product name here and nowhere else.
#
# One `KEY="value"` per line. `build.rs` turns each line into the compile-time
# variable `BRAND_<KEY>`, which `src/branding.rs` exposes as `branding::<KEY>`.
# Packaging scripts may read this file too (it is plain `KEY="value"`, so a
# shell can source it): keep values on one line, without `"` or `\` in them.
#
# A key added here must also be added to `src/branding.rs`, and the other way
# round: the build fails when the two lists differ.

# Names shown to the user.
PRODUCT_NAME="Unaligned IDE"
PRODUCT_SHORT_NAME="Unaligned"
PUBLISHER="Unaligned"

# Identifiers. APP_ID names every directory, log file, socket and mutex of the
# app; it must never be "zed" (the app would share a real Zed's files).
APP_ID="unaligned-ide"
REVERSE_DNS_ID="pw.unaligned.ide"
URL_SCHEME="unaligned-ide"
# The folder of a project's own settings, tasks and debug scenarios (like
# `.vscode`). Also written in assets/settings/default.json and in tests:
# script/unaligned/rename-upstream-names lists the places.
PROJECT_DIR=".unaligned"
USER_AGENT_PRODUCT="UnalignedIDE"
KEYCHAIN_PREFIX="unaligned-ide:"

# What Windows knows an installation by (the Inno Setup AppId, without braces).
# It must never change once a release is out: an installer with another value
# installs a second copy beside the first instead of updating it.
WINDOWS_INSTALLER_GUID="04AB06D9-1982-4F03-A5B3-D806E8639A7C"

# Addresses of the product and of the featured provider.
WEBSITE_URL="https://unaligned.pw"
DOCS_URL="https://unaligned.pw/docs"
SUPPORT_URL="https://unaligned.pw/contact"
PROVIDER_KEYS_URL="https://unaligned.pw/dashboard/keys"
PROVIDER_BILLING_URL="https://unaligned.pw/dashboard/billing"
PROVIDER_API_URL="https://api.unaligned.pw"

# Not published yet: empty means "none" (see the functions in branding.rs).
# RELEASES_REPOSITORY is an `owner/repo` slug.
SOURCE_REPOSITORY_URL=""
RELEASES_REPOSITORY=""
ISSUES_URL=""
# The OAuth client metadata document of the product (a JSON file on its site,
# by which MCP servers that accept one identify the app). Empty: the app
# registers itself with each server instead. Never upstream's document: it
# would present the app as Zed.
OAUTH_CLIENT_METADATA_URL=""

# The extension registry is still upstream's.
EXTENSIONS_API_URL="https://api.zed.dev"

# Credit to the project this is a fork of.
UPSTREAM_NAME="Zed"
UPSTREAM_VERSION="1.30.0"
UPSTREAM_CREDIT="Based on Zed, © Zed Industries, Inc."
